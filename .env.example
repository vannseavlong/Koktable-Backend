# ─── Google OAuth2 (required) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/user/auth/callback
GOOGLE_ADMIN_REDIRECT_URI=http://localhost:3000/admin/auth/callback

# ─── Google Sheets IDs ────────────────────────────────────────────────────────
# Admin sheet: central registry (users, credentials, services, schema_versions)
ADMIN_SHEET_ID=your_admin_google_sheet_id
# Dev user sheet: used by `lsdb sync` for local development only
DEV_USER_SHEET_ID=your_dev_user_google_sheet_id

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── Merchant invite tokens ────────────────────────────────────────────────────
INVITE_TOKEN_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── EmailJS (merchant invite emails) ──────────────────────────────────────────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ─── Admin portal account ─────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me_to_a_strong_password

# ─── Admin Google Sheets Tokens ───────────────────────────────────────────────
GOOGLE_ADMIN_TOKENS=

# ─── Google Places API (scripts/backfill-district.ts only) ────────────────────
# A Maps Platform API key with the "Places API" enabled, restricted to it —
# NOT the same credential as GOOGLE_CLIENT_ID/SECRET above (those are OAuth2 client
# credentials for sign-in, not usable for Places calls). Not read by the running
# server, only by the one-off backfill script.
GOOGLE_PLACES_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
# Mobile app's custom URL scheme (deep link target after OAuth), not a browser URL.
FRONTEND_URL=http://localhost:8081
# Admin portal web app — a real browser-navigable URL, also used as an allowed CORS origin.
ADMIN_FRONTEND_URL=http://localhost:5173
# Merchant-facing web app (invite acceptance page) — served from the admin_portal
# frontend (same app, public /invite/:token route). Only used to build the link
# embedded in the invite email.
MERCHANT_FRONTEND_URL=http://localhost:5173
# Customer-facing Web app (../Web) — CORS allow-listed origin only; Web's own dev
# server defaults to this port (see Web/AGENTS.md).
WEB_FRONTEND_URL=http://localhost:8443
NODE_ENV=development
